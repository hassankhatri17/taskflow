# Copy this file to .env for local dev, or set these as environment
# variables in your hosting provider's dashboard (e.g. Render).

# Port the server listens on. Most hosts (Render, Railway) inject this
# automatically — you usually don't need to set it yourself in production.
PORT=4000

# Secret used to sign JWTs. MUST be set to a long random string in
# production. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of origins allowed to call this API.
# Local dev:
CORS_ORIGIN=http://localhost:5173
# Production example:
# CORS_ORIGIN=https://your-taskflow-app.netlify.app
